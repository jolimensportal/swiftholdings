---
export const prerender = true;

import InnerAsk from '@/components/marketing/inner/InnerAsk.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import MarketLedger from '@/components/marketing/MarketLedger.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.protections;
---

<MarketingLayout seo={page.seo} headerTheme="dark">
  <MarketingHero
    {...page.hero}
    secondaryCta={page.secondaryCta}
    image={marketingImages.confidenceFeature}
    ratio="4 / 3"
  />

  <MarketLedger
    eyebrow="What confidence looks like"
    title="A useful distinction between what is clear and what needs direct discussion."
    body="Every protection below is confirmed in the dossier, and every open question is the subject of the private briefing."
    items={[
      {
        label: 'Deposits',
        value: 'Into escrow',
        note: 'before any build begins',
      },
      {
        label: 'Title',
        value: 'Ghanaian land law',
        note: 'verified before permits',
      },
      {
        label: 'Build',
        value: 'Insured',
        note: 'nine-layer wall system, CIGS solar-ready',
      },
      {
        label: 'Operations',
        value: 'One operator',
        note: 'Swift Horizon, five-year lock-in',
      },
      {
        label: 'Documents',
        value: 'Gated dossier',
        note: 'three long-form documents, behind the briefing',
      },
    ]}
    cta={{ label: 'Read the dossier', href: '/resources' }}
  />

  <InnerAsk
    tone="canvas"
    eyebrow="Private briefing"
    title="Ask the questions that shape your decision."
    body="The briefing is where current status, timing, pricing, and delivery get answered for your situation — and where the dossier opens."
    cta={{ label: 'Request a private briefing', href: '/briefing' }}
  />
</MarketingLayout>