---
export const prerender = true;

import ImageFrame from '@/components/marketing/ImageFrame.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import StorySplit from '@/components/marketing/StorySplit.astro';
import MarketLedger from '@/components/marketing/MarketLedger.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import { marketingSite } from '@/data/marketing/site';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.home;
---

<MarketingLayout seo={page.seo} headerTheme="dark">
  <MarketingHero
    {...page.hero}
    secondaryCta={page.secondaryCta}
    image={marketingImages.villageBanner}
    ratio="4 / 3"
  />

  <section class="marketing-container py-16 lg:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <p class="marketing-eyebrow">One project, three doors</p>
      <h2
        class="marketing-display mt-3 max-w-2xl text-4xl leading-[1.08] text-[var(--marketing-ink)]"
      >
        The ecosystem, open at three levels.
      </h2>
    </div>
    <div
      class="mt-10 grid gap-px border border-[var(--marketing-gold-line)] bg-[var(--marketing-gold-line)] lg:grid-cols-3"
    >
      {
        marketingSite.tiers.map((tier, index) => (
          <article class="bg-[var(--marketing-obsidian-900)] p-8 text-[var(--marketing-ink-on-dark)] lg:p-10">
            <p class="marketing-ledger-label">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="marketing-display mt-4 text-2xl">{tier.name}</h3>
            <p class="mt-3 text-sm leading-6 text-[var(--marketing-dim-on-dark)]">
              {tier.summary}
            </p>
            <a class="marketing-button-link mt-6" href={tier.cta.href}>
              {tier.cta.label}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <MarketLedger
    eyebrow="The market"
    title="The numbers that ground the project."
    body="Ghana's accommodation deficit is documented, not assumed. The ledger is public; the sources live in the dossier."
    items={[
      { label: 'Accra accommodation deficit', value: '300,000+' },
      { label: 'National deficit', value: '2,000,000+' },
      { label: 'Demand growth per year', value: '6–10%' },
      { label: 'Market occupancy', value: '33–44%' },
      { label: 'Unit target occupancy', value: '88%' },
    ]}
    cta={{ label: 'See the financials', href: '/ownership' }}
  />

  <StorySplit
    eyebrow="For the diaspora"
    title="A base to come home to."
    body="Every part of the project is shaped for the diaspora: USD-denominated numbers, English documentation, escrow before build, and a settlement in GHS when you are home."
    image={marketingImages.diasporaLifestyle}
    reverse
  />

  <section class="marketing-surface-dark">
    <div
      class="marketing-container grid items-center gap-10 py-16 lg:grid-cols-[1fr_0.9fr] lg:py-20"
    >
      <ImageFrame image={marketingImages.duskCta} ratio="3 / 2" />
      <div>
        <p class="marketing-eyebrow">The next step</p>
        <h2
          class="marketing-display mt-3 max-w-lg text-4xl leading-[1.08] text-[var(--marketing-ink-on-dark)]"
        >
          Every conversation starts with a briefing.
        </h2>
        <p class="mt-4 max-w-lg leading-7 text-[var(--marketing-dim-on-dark)]">
          Tell us what you are planning. The briefing decides the level of
          detail you see — and it is the only door into the member material.
        </p>
        <a class="marketing-button-primary mt-7" href="/briefing">
          Request a briefing
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>
