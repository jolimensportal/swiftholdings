---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Hero from '@sections/HeroSection.astro';
import SwiftStats from '@sections/SwiftStats.astro';
import TheModelSection from '@sections/TheModelSection.astro';
import InvestmentSection from '@sections/InvestmentSection.astro';
import InsightsSection from '@sections/InsightsSection.astro';
import ProtectionsSection from '@sections/ProtectionsSection.astro';
import LeadCTA from '@sections/LeadCTA.astro';
---

<BaseLayout
  seo={{
