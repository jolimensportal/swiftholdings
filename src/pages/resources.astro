---
export const prerender = true;

import InnerAsk from '@/components/marketing/inner/InnerAsk.astro';
import InnerStatement from '@/components/marketing/inner/InnerStatement.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.resources;
---

<MarketingLayout seo={page.seo} headerTheme="dark">
  <MarketingHero
    {...page.hero}
    secondaryCta={page.secondaryCta}
    image={marketingImages.warmDetail}
    ratio="3 / 2"
  />

  <InnerStatement
    tone="canvas"
    numeral="I"
    label="What is published"
    title="The public documents, and what sits behind the gate."
    body="Some of this you can read now. The rest opens after the briefing, which is where the full yield tables, availability and legal dossier live."
    image={marketingImages.briefingClose}
    ratio="3 / 2"
  />

  <InnerAsk
    tone="obsidian"
    eyebrow="Next step"
    title="Open the gated documents in a briefing."
    cta={{ label: 'Request a briefing', href: '/briefing' }}
  />
</MarketingLayout>
