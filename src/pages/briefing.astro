---
import DiscoveryForm from '@/components/marketing/DiscoveryForm.client';
import ImageFrame from '@/components/marketing/ImageFrame.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.briefing;
const nextSteps = [
  'Five guided steps — about you, your intent, your plans.',
  'Your gate opens the moment you submit.',
  'The long-form documents appear on the other side.',
];
---

<MarketingLayout seo={page.seo}>
  <section
    class="marketing-container grid gap-12 py-12 lg:grid-cols-[0.8fr_1.2fr] lg:py-20"
  >
    <div>
      <p class="marketing-eyebrow">{page.hero.eyebrow}</p>
      <h1
        class="marketing-display mt-4 max-w-lg text-5xl leading-[1.05] text-[var(--marketing-ink)] sm:text-6xl"
      >
        {page.hero.title}
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-8 text-[var(--marketing-muted)]">
        {page.hero.lead}
      </p>
      <ol class="mt-10 grid gap-5 border-t border-[var(--marketing-rule)] pt-6">
        {
          nextSteps.map((step, index) => (
            <li class="grid grid-cols-[auto_1fr] gap-3">
              <span class="marketing-ledger-label">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="pt-0.5 text-[var(--marketing-ink)]">{step}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 max-w-md text-sm leading-6 text-[var(--marketing-muted)]">
        The briefing takes about five minutes. Your details are used only to
        open your member gate and prepare your call.
      </p>
    </div>
    <div
      class="border-t border-[var(--marketing-rule)] pt-6 lg:border-t-0 lg:pt-0"
    >
      <DiscoveryForm client:load />
    </div>
  </section>

  <section class="border-y border-[var(--marketing-rule)] py-16">
    <div
      class="marketing-container grid items-center gap-8 lg:grid-cols-[0.85fr_1fr]"
    >
      <ImageFrame image={marketingImages.briefingClose} ratio="3 / 2" />
      <div>
        <p class="marketing-eyebrow">A personal next step</p>
        <h2 class="marketing-display mt-3 text-4xl text-[var(--marketing-ink)]">
          Start with the context that matters to you.
        </h2>
        <p class="mt-5 max-w-xl leading-8 text-[var(--marketing-muted)]">
          There is no public sales funnel here. Walk the five steps and the gate
          opens — full yield tables, availability, pricing, and the legal
          dossier, all in your member area.
        </p>
      </div>
    </div>
  </section>
</MarketingLayout>
