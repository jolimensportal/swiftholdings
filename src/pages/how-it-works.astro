---
export const prerender = true;

import ImageFrame from '@/components/marketing/ImageFrame.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import NumberedSteps from '@/components/marketing/NumberedSteps.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.howItWorks;
const steps = [
  {
    title: 'Start with a private briefing',
    body: 'Share what you are looking for and the questions you need answered.',
  },
  {
    title: 'Explore the village direction',
    body: 'Review the Oyarifa concept, reference visuals, and what is currently known.',
  },
  {
    title: 'Understand the path before deciding',
    body: 'Talk through buyer fit, timing, practical next steps, and open questions.',
  },
  {
    title: 'Prepare for the next confirmed step',
    body: 'Move forward only with the information and documentation appropriate to your decision.',
  },
];
---

<MarketingLayout seo={page.seo}>
  <MarketingHero
    {...page.hero}
    image={marketingImages.ownershipStory}
    ratio="3 / 2"
  />
  <NumberedSteps
    eyebrow="A four-part conversation"
    title="A clear path before any decision."
    steps={steps}
  />

  <section class="border-y border-[var(--marketing-rule)] bg-white py-16">
    <div
      class="marketing-container grid items-center gap-8 md:grid-cols-[0.9fr_1fr]"
    >
      <ImageFrame image={marketingImages.warmDetail} ratio="4 / 3" />
      <div>
        <p class="marketing-eyebrow">Your next question</p>
        <h2 class="mt-3 text-4xl font-semibold tracking-[-0.04em]">
          Begin with the details that matter to you.
        </h2>
        <p class="mt-5 max-w-xl leading-8 text-[var(--marketing-muted)]">
          A private briefing gives you space to understand the current direction
          and identify the next information you need.
        </p>
        <a class="marketing-button-primary mt-7" href="/briefing"
          >Request a private briefing</a
        >
      </div>
    </div>
  </section>
</MarketingLayout>
