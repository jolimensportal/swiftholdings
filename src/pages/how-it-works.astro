---
export const prerender = true;

import MarketingHero from '@/components/marketing/MarketingHero.astro';
import TimelineSteps from '@/components/marketing/TimelineSteps.astro';
import MarketLedger from '@/components/marketing/MarketLedger.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.howItWorks;
const phases = [
  {
    name: 'Land & permits',
    duration: 'Phase 1',
    body: 'Title verified under Ghanaian land law, permits secured, and the site prepared.',
  },
  {
    name: 'Foundation',
    duration: 'Phase 2',
    body: 'Ground works and the structural base that every capsule sits on.',
  },
  {
    name: 'Delivery',
    duration: 'Phase 3',
    body: 'The P7 capsule arrives: 38 m², nine-layer wall system, solar-ready.',
  },
  {
    name: 'Installation & finish',
    duration: 'Phase 4',
    body: 'Interiors, services, and the walkthrough that makes it a home.',
  },
  {
    name: 'Revenue',
    duration: 'Phase 5',
    body: 'Stays open on the market — and the 70 / 30 settlement starts.',
  },
] as const;
---

<MarketingLayout seo={page.seo}>
  <MarketingHero
    {...page.hero}
    secondaryCta={page.secondaryCta}
    image={marketingImages.homeDetail}
    ratio="3 / 2"
  />

  <TimelineSteps {phases} />

  <MarketLedger
    eyebrow="The lock-in"
    title="Five years of one operating partner."
    body="Every capsule is operated by The Swift Project for five years from first revenue. That is what makes the 70 / 30 legible — one operator, one ledger, one settlement."
    items={[
      { label: 'Lock-in', value: '5 years' },
      { label: 'Operator', value: 'The Swift Project' },
      { label: 'Share', value: '70 / 30' },
      { label: 'Settlement', value: 'Monthly · USD held, GHS settled' },
      { label: 'After the lock-in', value: 'Renew, or take full control' },
    ]}
    cta={{ label: 'See the protections', href: '/protections' }}
  />
</MarketingLayout>