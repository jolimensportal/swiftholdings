<style>
  /* ===== Video hero ===== */
  .beta-hero {
    position: relative;
    width: 100%;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: #0f0e0d;
  }
  @media (min-width: 1024px) {
    .beta-hero { min-height: 600px; }
  }
  @media (max-width: 767px) {
    .beta-hero { min-height: 620px; }
  }

  .beta-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.8) contrast(1.03) saturate(0.85);
  }
  .beta-hero__video--fallback {
    filter: brightness(0.75) contrast(1.02) saturate(0.8);
  }

  .beta-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(10, 9, 8, 0.18) 0%,
      rgba(10, 9, 8, 0.38) 42%,
      rgba(10, 9, 8, 0.82) 100%
    );
  }

  .beta-hero__tag {
    position: absolute;
    top: 18px;
    right: 22px;
    z-index: 3;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--marketing-dim-on-dark);
    margin: 0;
  }

  .beta-hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 32px;
  }
  @media (max-width: 767px) {
    .beta-hero__content { padding: 56px 20px; }
  }

  .beta-hero__title {
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.06;
    max-width: 720px;
    margin: 22px 0 18px;
    color: var(--marketing-ink-on-dark);
  }

  .beta-hero__lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--marketing-dim-on-dark);
    max-width: 520px;
  }
</style>
