  <!-- ===== VIDEO HERO ===== -->
  <section class="beta-hero">
    {isEmbed ? (
      <iframe
        class="beta-hero__video"
        src={embedSrc}
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        loading="lazy"
        title="The Swift Project preview"
      />
    ) : (
      <>
        <video
          class="beta-hero__video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroPoster}
        >
          <source src={heroVideoUrl} type="video/mp4" />
        </video>
      </>
    )}
    <div class="beta-hero__scrim"></div>
    <p class="beta-hero__tag">A private preview · 2026</p>
