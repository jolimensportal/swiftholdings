---
export const prerender = true;

import MarketingHero from '@/components/marketing/MarketingHero.astro';
import StorySplit from '@/components/marketing/StorySplit.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.accra;
const prompts = [
  'How often will you be in Accra?',
  'Who will use the home?',
  'What needs to be clear before you decide?',
];
---

<MarketingLayout seo={page.seo}>
  <MarketingHero
    {...page.hero}
    image={marketingImages.homeDetail}
    ratio="3 / 2"
  />
  <StorySplit
    {...page.story}
    image={marketingImages.confidenceFeature}
    ratio="4 / 3"
    reverse
  />

  <section class="marketing-container py-16 lg:py-24">
    <p class="marketing-eyebrow">Private briefing prompts</p>
    <h2 class="mt-3 max-w-2xl text-4xl font-semibold tracking-[-0.04em]">
      A useful next step starts with your own return rhythm.
    </h2>
    <ol
      class="mt-10 grid gap-5 border-t border-[var(--marketing-rule)] pt-6 md:grid-cols-3"
    >
      {
        prompts.map((prompt, index) => (
          <li class="grid grid-cols-[auto_1fr] items-start gap-3">
            <span class="grid size-7 place-items-center rounded-full bg-[#2A1C46] text-xs font-bold text-white">
              {index + 1}
            </span>
            <p class="pt-0.5 text-lg leading-7 font-semibold">{prompt}</p>
          </li>
        ))
      }
    </ol>
    <a class="marketing-button-primary mt-10" href="/briefing"
      >Request a private briefing</a
    >
  </section>
</MarketingLayout>
