---
export const prerender = true;

import InnerAsk from '@/components/marketing/inner/InnerAsk.astro';
import InnerStatement from '@/components/marketing/inner/InnerStatement.astro';
import MovementTag from '@/components/marketing/home/MovementTag.astro';
import Plate from '@/components/marketing/home/Plate.astro';
import SectionShell from '@/components/marketing/home/SectionShell.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import MarketingLayout from '@layout/MarketingLayout.astro';

const stages = [
  {
    numeral: 'I',
    title: 'Surveyed plot, permitted ground',
    body: 'A hub is chosen on documented demand, surveyed, and carried through its municipal clearances before anything is built.',
  },
  {
    numeral: 'II',
    title: 'Factory-built, delivered in weeks',
    body: 'Capsules are precision-engineered off site and craned into place, so a village goes from bare ground to finished units in months rather than years.',
  },
  {
    numeral: 'III',
    title: 'One operator, monthly settlement',
    body: 'Swift Horizon runs the village end to end and settles in GHS every month, so ownership needs no management from you.',
  },
];
---

<MarketingLayout
  seo={{
    title: 'The Model · Swift Horizon',
    description:
      'How a Swift Horizon village goes from surveyed plot to finished capsules: three stages, one operator, monthly settlement.',
  }}
  headerTheme="dark"
>
  <MarketingHero
    eyebrow="The Model"
    title="How the village works."
    lead="Three stages, from surveyed plot to monthly yield — designed so a diaspora investor can own part of a Ghanaian village without managing a single brick."
    secondaryCta={{ label: 'See the locations', href: '/locations' }}
    image={marketingImages.villageBanner}
    ratio="21 / 9"
  />

  <SectionShell tone="canvas">
    <MovementTag numeral="I" label="Three stages" />
    <ol class="stages">
      {
        stages.map(stage => (
          <li>
            <p class="stage-numeral">{stage.numeral}</p>
            <h2 class="stage-title">{stage.title}</h2>
            <p class="stage-body">{stage.body}</p>
          </li>
        ))
      }
    </ol>
  </SectionShell>

  <SectionShell tone="obsidian">
    <MovementTag numeral="II" />
    <div class="stillness">
      <Plate image={marketingImages.warmDetail} ratio="16 / 9" />
    </div>
  </SectionShell>

  <InnerStatement
    tone="canvas"
    numeral="III"
    label="Designed for distance"
    title="Own part of a village without managing a single brick."
    body="The model exists so someone living abroad can hold a real, finished residence in Ghana and still have it run properly when they are not there."
    image={marketingImages.diasporaLifestyle}
    ratio="3 / 2"
  />

  <InnerAsk
    tone="obsidian"
    eyebrow="Private briefing"
    title="Ask about the model in detail."
    cta={{ label: 'Request a private briefing', href: '/briefing' }}
  />
</MarketingLayout>

<style>
  .stages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 860px) {
    .stages {
      grid-template-columns: 1fr;
    }
  }

  .stage-numeral {
    margin: 0 0 0.85rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ground-gold-on-canvas);
  }

  .stage-title {
    margin: 0 0 0.7rem;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ground-ink-on-canvas);
  }

  .stage-body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.58;
    color: var(--ground-ink-dim-on-canvas);
  }

  .stillness {
    display: grid;
    grid-template-columns: minmax(0, 72ch);
    justify-content: center;
  }
</style>
