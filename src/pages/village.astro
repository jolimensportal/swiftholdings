---
export const prerender = true;

import InnerAsk from '@/components/marketing/inner/InnerAsk.astro';
import InnerStatement from '@/components/marketing/inner/InnerStatement.astro';
import MovementTag from '@/components/marketing/home/MovementTag.astro';
import Plate from '@/components/marketing/home/Plate.astro';
import SectionShell from '@/components/marketing/home/SectionShell.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.village;
---

<MarketingLayout seo={page.seo} headerTheme="dark">
  <MarketingHero
    {...page.hero}
    secondaryCta={page.secondaryCta}
    image={marketingImages.villageBanner}
    ratio="21 / 9"
  />

  <InnerStatement
    tone="canvas"
    numeral="I"
    label="The village"
    title="Capsules in common, land held in common."
    body="Owner-investors hold the capsule; the village holds the land. Shared walls, shared infrastructure, and a calmer rhythm than the city core — a compound, not a complex."
    image={marketingImages.villageStory}
    ratio="3 / 2"
  />

  <SectionShell tone="obsidian">
    <MovementTag numeral="II" />
    <div class="stillness">
      <Plate image={marketingImages.homeDetail} ratio="4 / 3" />
    </div>
  </SectionShell>

  <InnerAsk
    tone="canvas"
    eyebrow="Private briefing"
    title="Bring your plans to the conversation."
    body="A private briefing is the place to ask about the village, local context, and the details that matter to you."
    cta={{ label: 'Request a private briefing', href: '/briefing' }}
  />
</MarketingLayout>

<style>
  .stillness {
    display: grid;
    grid-template-columns: minmax(0, 68ch);
    justify-content: center;
  }
</style>