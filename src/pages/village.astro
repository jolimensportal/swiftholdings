---
export const prerender = true;

import ImageFrame from '@/components/marketing/ImageFrame.astro';
import MarketingHero from '@/components/marketing/MarketingHero.astro';
import StorySplit from '@/components/marketing/StorySplit.astro';
import { marketingImages } from '@/data/marketing/image-assets';
import { marketingPages } from '@/data/marketing/pages';
import MarketingLayout from '@layout/MarketingLayout.astro';

const page = marketingPages.village;
---

<MarketingLayout seo={page.seo}>
  <MarketingHero
    {...page.hero}
    secondaryCta={page.secondaryCta}
    image={marketingImages.villageBanner}
    ratio="21 / 9"
  />

  <StorySplit
    eyebrow="The village"
    title="Capsules in common, land held in common."
    body="Owner-investors hold the capsule; the village holds the land. Shared walls, shared infrastructure, and a calmer rhythm than the city core — a compound, not a complex."
    image={marketingImages.villageStory}
    reverse
  />

  <section class="marketing-container grid gap-5 py-16 lg:py-24">
    <ImageFrame image={marketingImages.homeDetail} ratio="4 / 3" />
  </section>

  <section class="border-y border-[var(--marketing-rule)] py-16">
    <div class="marketing-container max-w-3xl text-center">
      <p class="marketing-eyebrow">Private briefing</p>
      <h2
        class="marketing-display mt-3 text-4xl text-[var(--marketing-ink)]"
      >
        Bring your plans to the conversation.
      </h2>
      <p class="mx-auto mt-5 max-w-xl leading-8 text-[var(--marketing-muted)]">
        A private briefing is the place to ask about the village, local
        context, and the details that matter to you.
      </p>
      <a class="marketing-button-primary mt-7" href="/briefing"
        >Request a private briefing</a
      >
    </div>
  </section>
</MarketingLayout>