---
export const prerender = true;

import MarketingLayout from '@layout/MarketingLayout.astro';

const seo = {
  title: 'Page not found | Swift Holdings',
  description:
    'The page you requested is not part of the current Swift Holdings site.',
};
---

<MarketingLayout {seo}>
  <section
    class="marketing-container grid min-h-[60vh] place-items-center py-20 text-center"
  >
    <div class="max-w-2xl">
      <p class="marketing-eyebrow">404</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.05em] sm:text-6xl">
        Page not found
      </h1>
      <p class="mt-6 text-lg leading-8 text-[var(--marketing-muted)]">
        The page you requested is not part of the current Swift Holdings site.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-5">
        <a class="marketing-button-primary" href="/">Return home</a>
        <a class="marketing-button-link self-center" href="/briefing"
          >Request a private briefing</a
        >
      </div>
    </div>
  </section>
</MarketingLayout>
