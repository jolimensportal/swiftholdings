---
// Blueprint-style elevation drawing of a Swift Holdings prefab capsule home.
const stroke = '#334155';
const faint = '#64748b';
const fill = 'rgba(15,23,42,0.04)';
---

<div class="bg-off-white border border-slate-900/15 p-4 sm:p-6">
  <svg
    viewBox="0 0 800 380"
    class="block w-full text-slate-700"
    role="img"
    aria-label="Blueprint elevation of a Swift Holdings prefab capsule home"
  >
    {/* Ground line */}
    <line x1="40" y1="320" x2="760" y2="320" stroke={faint} stroke-width="1"
    ></line>

    {/* House body */}
    <rect
      x="150"
      y="150"
      width="400"
      height="170"
      fill={fill}
      stroke={stroke}
      stroke-width="1.5"></rect>

    {/* Gable roof */}
    <polygon
      points="130,150 350,95 570,150"
      fill="none"
      stroke={stroke}
      stroke-width="1.5"></polygon>

    {/* Windows */}
    <rect
      x="190"
      y="190"
      width="80"
      height="70"
      fill="none"
      stroke={stroke}
      stroke-width="1"></rect>
    <rect
      x="300"
      y="190"
      width="80"
      height="70"
      fill="none"
      stroke={stroke}
      stroke-width="1"></rect>

    {/* Door */}
    <rect
      x="440"
      y="215"
      width="70"
      height="105"
      fill="none"
      stroke={stroke}
      stroke-width="1"></rect>
    <line
      x1="478"
      y1="225"
      x2="478"
      y2="310"
      stroke={stroke}
      stroke-width="0.75"></line>

    {/* Width dimension */}
    <g stroke={faint} stroke-width="1">
      <line x1="150" y1="60" x2="550" y2="60"></line>
      <line x1="150" y1="52" x2="150" y2="68"></line>
      <line x1="550" y1="52" x2="550" y2="68"></line>
    </g>
    <text
      x="350"
      y="50"
      text-anchor="middle"
      font-family="monospace"
      font-size="13"
      fill={faint}>8.0 m</text
    >

    {/* Height dimension */}
    <g stroke={faint} stroke-width="1">
      <line x1="105" y1="150" x2="105" y2="320"></line>
      <line x1="97" y1="150" x2="113" y2="150"></line>
      <line x1="97" y1="320" x2="113" y2="320"></line>
    </g>
    <text
      x="92"
      y="240"
      text-anchor="middle"
      font-family="monospace"
      font-size="13"
      fill={faint}
      transform="rotate(-90 92 240)">3.2 m</text
    >

    {/* Tree */}
    <g stroke={stroke} stroke-width="1" fill="none">
      <line x1="660" y1="320" x2="660" y2="250"></line>
      <circle cx="660" cy="225" r="30"></circle>
      <circle cx="635" cy="245" r="18"></circle>
      <circle cx="685" cy="245" r="18"></circle>
    </g>

    {/* Title block */}
    <text x="40" y="360" font-family="monospace" font-size="13" fill={stroke}
      >CAPSULE A — ELEVATION</text
    >
    <text
      x="760"
      y="360"
      text-anchor="end"
      font-family="monospace"
      font-size="11"
      fill={faint}>SCALE 1:50 · SWIFT HOLDINGS</text
    >
  </svg>
</div>
