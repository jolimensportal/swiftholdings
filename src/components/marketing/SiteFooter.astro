---
import { marketingSite } from '@/data/marketing/site';

const phoneHref = `tel:${marketingSite.phone.replace(/\s/g, '')}`;
---

<footer class="border-t border-[var(--marketing-rule)] bg-white py-10">
  <div
    class="marketing-container grid gap-8 text-sm md:grid-cols-[1fr_auto] md:items-end"
  >
    <div>
      <p class="font-bold tracking-[0.04em]">
        SWIFT <span class="font-normal">HOLDINGS</span>
      </p>
      <p class="mt-3 max-w-md leading-6 text-[var(--marketing-muted)]">
        Illustrative reference imagery used for concept direction.
      </p>
    </div>
    <div class="grid gap-2 text-[var(--marketing-muted)] md:text-right">
      <a
        class="hover:text-[var(--marketing-ink)]"
        href={`mailto:${marketingSite.email}`}
      >
        {marketingSite.email}
      </a>
      <a class="hover:text-[var(--marketing-ink)]" href={phoneHref}
        >{marketingSite.phone}</a
      >
      <p>{marketingSite.address}</p>
      <a class="marketing-button-link mt-2" href="/briefing"
        >Request a private briefing</a
      >
    </div>
  </div>
</footer>
