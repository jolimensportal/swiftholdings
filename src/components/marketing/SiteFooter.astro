---
import { marketingSite } from '@/data/marketing/site';
---

<footer class="site-footer" role="contentinfo">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path
          d="M16 2L22 14H10L16 2Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path
          d="M16 2V30M4 14H28"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
      <span style="font-family: var(--font-sans); font-size: 0.875rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;">SWIFT HOLDINGS</span>
    </div>

    <nav class="site-footer-links" aria-label="Footer navigation">
      <a href="/#vision">Our Vision</a>
      <a href="/#asset">The Asset</a>
      <a href="/#locations">Locations</a>
      <a href="/#partnership">Partnership</a>
      <a href="/briefing">Request Briefing</a>
    </nav>

    <p class="site-footer-copyright">
      © {new Date().getFullYear()} {marketingSite.legalName}. All rights reserved.
    </p>
  </div>
</footer>