---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'dark' } = Astro.props;
---

<header class="site-header" role="banner">
  <a href="/" class="site-header-brand" aria-label="Swift Holdings home">
    <svg class="site-header-logo" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path
        d="M16 2L22 14H10L16 2Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <path
        d="M16 2V30M4 14H28"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
    <span class="site-header-wordmark">SWIFT HOLDINGS</span>
  </a>

  <nav class="site-header-nav" aria-label="Primary navigation">
    <a href="/#vision" class="site-header-nav-link">Our Vision</a>
    <a href="/#asset" class="site-header-nav-link">The Asset</a>
    <a href="/#locations" class="site-header-nav-link">Locations</a>
    <a href="/#partnership" class="site-header-nav-link">Partnership</a>
    <a
      href="/briefing"
      class="site-header-cta"
    >
      Request a Private Briefing
    </a>
  </nav>

  <details class="mobile-menu">
    <summary class="mobile-menu-toggle" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>
    </summary>
    <nav class="mobile-menu-panel" aria-label="Mobile navigation">
      <a href="/#vision" class="mobile-menu-link">Our Vision</a>
      <a href="/#asset" class="site-header-nav-link">The Asset</a>
      <a href="/#locations" class="site-header-nav-link">Locations</a>
      <a href="/#partnership" class="site-header-nav-link">Partnership</a>
      <a href="/briefing" class="marketing-button-primary" style="width: 100%;">Request a Private Briefing</a>
    </nav>
  </details>
</header>

<style>
  .site-header-nav-link {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: 400;
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .site-header-nav-link:hover {
    color: var(--accent-light);
  }
  .mobile-menu-toggle {
    background: none;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .mobile-menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 20;
    min-width: 200px;
    background: var(--header-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .mobile-menu-link {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 180ms var(--ease), color 180ms var(--ease);
  }
  .mobile-menu-link:hover {
    background: rgba(208,172,122,0.08);
    color: var(--accent-light);
  }
</style>