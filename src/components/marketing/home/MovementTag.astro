---
interface Props {
  numeral: string;
  label?: string;
}

const { numeral, label } = Astro.props;
---

<p class="movement-tag">
  <span class="numeral">{numeral}</span>
  {label && <span class="label">{label}</span>}
</p>

<style>
  /* Gold is ~9:1 on obsidian and 1.4:1 on canvas, and the section label token is
     likewise a dark-ground value. Both are resolved per ground here rather than
     in each caller, because this tag is used on both. */
  .movement-tag {
    --tag-numeral: var(--marketing-gold-400);
    /* Was --text-secondary, which is a THEME token: light mode redefines it to
       #3E3A33 for a pale page, but the section grounds stay fixed by design, so
       the label went near-black on obsidian at 1.71:1. This needs a GROUND
       token, and --surface-ink-dim resolves per ground without following the
       theme. */
    --tag-label: var(--surface-ink-dim);
    --tag-rule: var(--marketing-gold-line);

    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.16em;
    color: var(--tag-numeral);
    font-variant-numeric: tabular-nums;
  }

  /* The descendant combinator has to sit OUTSIDE :global(), otherwise Astro
     compiles this to `.movement-tag[cid].marketing-surface-canvas` — a compound
     selector demanding both classes on the same element, when the surface class
     is on the ancestor section. That silently never matched. */
  :global(.marketing-surface-canvas) .movement-tag {
    --tag-numeral: var(--ground-gold-on-canvas);
    --tag-label: #55504A;
    --tag-rule: var(--ground-rule-on-canvas);
  }

  .movement-tag::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--tag-rule);
  }

  /* The numeral is set in the sans at 600 rather than the display face.
     Cormorant is a high-contrast face whose strokes are hairlines at this size,
     so "I", "II" and "III" read as vertical rules rather than as characters —
     indistinguishable from the divider beside them. Kept as Roman numerals
     because they signal "movement"; digits would read as pagination. */
  .numeral {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  .label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tag-label);
  }
</style>