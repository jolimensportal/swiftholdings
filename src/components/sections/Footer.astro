---
import FooterForm from '@ui/forms/FooterForm.astro';
import ContactInfo from '@common/ContactInfo.astro';
import { figures } from '@utils/figures';

const companyName = 'Swift Holdings';
const companyDescription =
  'Swift Holdings develops income-generating prefab housing communities for the African diaspora. Our flagship village is in Oyarifa, Accra — fractional ownership from $100 a share.';

const contactDetails = {
  address: figures.contacts.address,
  phone: figures.contacts.phoneGh,
  email: figures.contacts.email,
  website: 'swiftholdings.org',
};

const copyrightYear = new Date().getFullYear();

const disclaimer =
  'Private placement. Not a regulated securities offering in every jurisdiction. For eligible investors only — consult your professional adviser before investing.';
---

<footer
  class="mt-auto w-full bg-linear-to-t/oklch from-slate-200 via-transparent to-white pb-10"
>
  <div class="mx-auto mt-auto w-full max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8">
    <hr class="mb-10 border-slate-200" />

    <div class="grid grid-cols-2 gap-6 md:grid-cols-5">
      <div class="col-span-full self-center xl:col-span-2">
        <a
          href="/"
          class="dm-sans flex-none text-xl font-semibold text-slate-900 uppercase focus:opacity-80 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-slate-700/80 focus-visible:ring-offset-2"
          aria-label={`${companyName} Homepage`}
        >
          {companyName}
        </a>
        <p class="mt-5 text-pretty text-slate-600 lg:w-5/12 xl:w-10/12">
          {companyDescription}
        </p>
      </div>

      <div class="col-span-1 md:col-span-2 xl:col-span-1 xl:col-start-3">
        <ContactInfo {...contactDetails} />
      </div>

      <div class="col-span-2 md:col-span-3 xl:col-span-2">
        <h3 class="font-semibold text-slate-900">Investor updates</h3>
        <FooterForm />
      </div>
    </div>

    <hr class="mt-10 mb-5 border-slate-200" />

    <div
      class="grid gap-y-2 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      <p class="text-sm text-slate-400/50">
        &copy; {copyrightYear}
        {` `}
        {companyName}
      </p>

      <p class="max-w-xl text-sm text-slate-400/50">
        {disclaimer}
      </p>
    </div>
  </div>
</footer>
