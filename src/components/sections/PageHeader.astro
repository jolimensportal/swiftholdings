---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-off-white">
  <div class="blueprint-grid pointer-events-none absolute inset-0 -z-10"></div>
  <div
    class="mx-auto max-w-[85rem] px-4 pt-40 pb-14 sm:px-6 lg:px-8 lg:pt-44 lg:pb-20"
  >
    {
      eyebrow && (
        <div class="hero-word mb-4 flex items-center gap-3" style="--d:0ms">
          <span class="rule-thin w-10"></span>
          <span class="font-work-sans text-xs font-medium uppercase tracking-[0.3em] text-slate-500">
            {eyebrow}
          </span>
        </div>
      )
    }
    <h1
      class="hero-word dm-sans max-w-4xl text-4xl font-medium tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
      style="--d:120ms"
    >
      {title}
    </h1>
    {
      lead && (
        <p
          class="hero-word mt-6 max-w-2xl text-lg text-pretty text-slate-600"
          style="--d:240ms"
        >
          {lead}
        </p>
      )
    }
  </div>
</section>
