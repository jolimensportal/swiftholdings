---
import { AstroFont } from 'astro-font';
import { SEO } from 'astro-seo';
import SignOutButton from '@/components/marketing/SignOutButton.client';
import '@styles/global.css';
import '@styles/marketing.css';
import '@styles/print.css';
import { marketingSite } from '@/data/marketing/site';

interface Props {
  seo: { title: string; description: string };
}

const { seo } = Astro.props;
---

<html lang="en">
  <head>
    <SEO
      charset="utf-8"
      title={seo.title}
      description={seo.description}
      noindex
      nofollow
      extend={{
        link: [
          { rel: 'icon', href: '/icon.svg', type: 'image/svg+xml' },
          { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
          { rel: 'manifest', href: '/manifest.webmanifest' },
        ],
        meta: [{ name: 'viewport', content: 'width=device-width' }],
      }}
    />
    <AstroFont
      config={[
        {
          src: [],
          name: 'Manrope',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&display=swap',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Cormorant Garamond',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&display=swap',
          preload: true,
          display: 'swap',
          selector: '.marketing-display',
          fallback: 'serif',
        },
      ]}
    />
  </head>
  <body
    class="marketing-shell bg-[var(--marketing-obsidian-950)] text-[var(--marketing-ink-on-dark)]"
  >
    <header class="print:hidden">
      <div
        class="marketing-container flex items-center justify-between gap-6 py-6"
      >
        <a
          href="/"
          class="marketing-display text-xl text-[var(--marketing-gold-400)]"
        >
          The Swift Project
        </a>
        <nav class="flex items-center gap-6 text-sm">
          <a
            href="/members"
            class="text-[var(--marketing-ink-on-dark)] hover:text-[var(--marketing-gold-400)]"
          >
            Documents
          </a>
          <a
            href="/"
            class="hidden text-[var(--marketing-dim-on-dark)] hover:text-[var(--marketing-gold-400)] sm:block"
          >
            Public site
          </a>
          <SignOutButton client:load />
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="print:hidden">
      <div
        class="marketing-container flex flex-col gap-2 border-t border-[var(--marketing-gold-line)] py-8 text-xs leading-6 text-[var(--marketing-dim-on-dark)] sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          {marketingSite.legalName} · {marketingSite.address}
        </p>
        <p>Confidential · member materials stay inside the ecosystem</p>
      </div>
    </footer>
  </body>
</html>
