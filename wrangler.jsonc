{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swift-holdings",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swift-holdings",
      "database_id": "a7f608d9-da85-4700-99ab-acad8c9d3817"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8e77cb1ee62f4897b0ee4d01af641ec5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "swift-documents"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "swift-emails"
      }
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // Was true, which meant the Worker answered every request before the assets
    // router was consulted, so the rules in public/_redirects were never read and
    // all seven returned 200 with the destination's body instead of a 301.
    "run_worker_first": false,
    // Default auto-trailing-slash made every internal link take a 307 hop
    // (/village -> /village/). The site's own links are written without the
    // slash, so that makes the canonical URL the one we actually link to.
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "swifthorizon.com.gh",
      "custom_domain": true
    },
    {
      "pattern": "www.swifthorizon.com.gh",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production"
  }
}