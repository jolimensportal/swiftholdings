{
  "name": "swiftholdingsportal",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "cache_control": "no-cache"
  },
  "observability": {
    "enabled": true
  }
}
