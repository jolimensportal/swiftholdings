# Swift Holdings — form delivery configuration
# Copy this file to `.env` (which is gitignored) and fill in real values,
# OR set the same variables in the Vercel project dashboard (Settings → Environment Variables).
#
# Delivery chain (see src/pages/api/contact.ts and src/pages/api/newsletter.ts):
#   FORMSPREE_*_ENDPOINT is tried first, then FORM_WEBHOOK_*.
#   If BOTH are left blank, the API runs in demo mode: it validates + rate-limits
#   submissions and returns success, but sends nothing. Safe for local/preview.

# --- Contact lead form ---
# Option A (recommended): Formspree. Create a form at https://formspree.io, then paste its POST URL.
FORMSPREE_CONTACT_ENDPOINT=https://formspree.io/f/your_contact_form_id
# Option B: any webhook that accepts JSON (n8n, Make, Zapier, your own endpoint).
FORM_WEBHOOK_CONTACT=

# --- Newsletter signup ---
FORMSPREE_NEWSLETTER_ENDPOINT=https://formspree.io/f/your_newsletter_form_id
FORM_WEBHOOK_NEWSLETTER=
